rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 시세·일봉: 로그인한 사용자는 읽기만 가능. 쓰기는 서버(Admin SDK, 규칙 무시)만 한다.
    match /market/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /history/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 내 계좌: 본인 데이터만 읽고 쓴다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub}/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
// 참고: 모의투자라서 체결 계산을 앱(클라이언트)에서 하고, 본인만 자기 계좌를 바꿀 수 있게만 제한한다.
// 실제 돈이 걸린 서비스라면 주문 처리를 서버(Cloud Functions)로 옮겨야 한다.
